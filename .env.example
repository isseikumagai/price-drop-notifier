# このファイルを .env にコピーして、値を埋めてください（.env は git に入りません）。
#
# マイチャット（自分とのDM）に届かせる場合:
#   api.slack.com/apps → OAuth & Permissions → User Token Scopes に chat:write
#   → Install to Workspace → User OAuth Token（xoxp- で始まる）
SLACK_BOT_TOKEN=xoxp-xxxxxxxxxxxx

# 自分のメンバーID。Slack のプロフィール →「⋮」→ メンバーIDをコピー
SLACK_CHANNEL=U0000000000

# チャンネルに送る場合は、上の2つの代わりにこちらだけでも動きます。
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
